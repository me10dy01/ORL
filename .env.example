# 星辰数码商城智能客服系统 - 环境变量模板
# 复制为 .env 后按需修改，禁止提交真实 .env

APP_NAME=星辰数码商城智能客服
APP_ENV=dev
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# MySQL（本机本地示例，请替换为真实账号密码）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=orl_dev

# Ollama / RAG
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 上下文窗口（性能关键）：Ollama 对 qwen3 默认 32768，KV cache 约 4.8GB，
# 8GB 显卡装不下会卸载到 CPU（实测慢数倍）；4096 足够本场景
OLLAMA_NUM_CTX=4096
# 模型常驻时长（避免反复加载）
OLLAMA_KEEP_ALIVE=30m
# 单次最大输出 token 数（限制回答长度 → 直接缩短生成耗时）
OLLAMA_NUM_PREDICT=512
EMBEDDING_MODEL=bge-m3
LLM_MODEL=qwen3:8b
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=xingchen_knowledge
RAG_TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Rerank（Phase 10）
RERANK_TOP_K=6
RERANK_TOP_N=3
# Reranker：统一使用 Qwen3 8B 进行候选排序（本中文知识库实测优于 ONNX cross-encoder）。
RERANKER_IMPL=llm
# 在线 RAG 启用重排：向量 Top-K → LLM 排序 → Top-N。
RAG_RERANK_ENABLED=true

# Supervisor 路由策略（模型职责重构）
# auto：规则前置判定（0 次 LLM，毫秒级），判定不了/与实体特征冲突时升级 LLM Router（默认）
# rules_only：只用规则（0 次 LLM）| llm：旧行为（始终用完整提示词调 LLM）
ROUTER_MODE=auto
# Router 专用模型：留空则复用 LLM_MODEL；可指向更小模型（如 qwen3:0.6b）以进一步降延迟
ROUTER_LLM_MODEL=

# Agent 行为开关
# mixed 路由并行执行：单卡 GPU 上 Ollama 推理本身串行，实测无收益，默认串行
MIXED_PARALLEL=false
# QA 逐句归因：每题多一次 LLM 调用（实测约 +100s），默认关闭，评估时可用 --align
QA_SENTENCE_ALIGNMENT=false
# QA 策略：rule_first（规则先行，能判定则跳过 LLM）| llm | rule_only
QA_MODE=rule_first
# 回答缓存（精确匹配：改写后问题 + 模型名）
ANSWER_CACHE_ENABLED=true
