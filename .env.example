# 星辰数码商城智能客服系统 - 环境变量模板
# 复制为 .env 后按需修改，禁止提交真实 .env
#
# 分层约定：
# - 默认值以 app/config.py 为准（无 .env 也能启动）
# - .env 只写本机差异（尤其 MYSQL_PASSWORD）与临时调参
# - 下面列出全部可覆盖键，值与 config.py 默认一致，可整段省略

APP_NAME=星辰数码商城智能客服
LOG_LEVEL=INFO

# MySQL（请把 MYSQL_PASSWORD 改成你的真实密码）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=orl_dev

# Ollama / RAG
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 上下文窗口（性能关键）：Ollama 对 qwen3 默认 32768，KV cache 约 4.8GB，
# 8GB 显卡装不下会卸载到 CPU（实测慢数倍）；4096 足够本场景
OLLAMA_NUM_CTX=4096
# 模型常驻时长（避免反复加载）
OLLAMA_KEEP_ALIVE=30m
# 单次最大输出 token 数（限制回答长度 → 直接缩短生成耗时）
OLLAMA_NUM_PREDICT=512
EMBEDDING_MODEL=bge-m3
LLM_MODEL=qwen3:8b
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=xingchen_knowledge
RAG_TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 在线 RAG：向量 Top-K → LLM 重排 → Top-N（已固化）
RERANK_TOP_K=6
RERANK_TOP_N=3

# Router 专用模型：留空复用 LLM_MODEL；可指向更小模型（如 qwen3:0.6b）
ROUTER_LLM_MODEL=

# 回答缓存（精确匹配：改写后问题 + 模型名）
ANSWER_CACHE_ENABLED=true
